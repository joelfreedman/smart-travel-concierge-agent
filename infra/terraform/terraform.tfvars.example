# Copy to terraform.tfvars (gitignored) and set your GCP project ID before running `terraform apply`.
project_id                 = "your-gcp-project-id"
region                     = "us-central1"
service_name               = "smart-travel-concierge"
fast_model_name            = "gemini-2.5-flash"
planning_model_name        = "gemini-2.5-pro"
enable_cloud_dlp           = true
max_single_trip_budget_usd = 25000
