# ==============================================================================
# Smart Travel & Trip Budget Concierge Agent - Local Environment Template
# Copy to .env for local development. NEVER commit a populated .env file.
# ==============================================================================

# --- Authentication (choose ONE mode) ---
# Mode A: Local development with Google AI Studio API Key (injected via env var)
# GEMINI_API_KEY=<set-your-api-key-locally-never-commit>
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Mode B: Production / GCP with Vertex AI & Secret Manager
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# USE_SECRET_MANAGER=true
# GEMINI_API_KEY_SECRET_NAME=travel-concierge-gemini-api-key

# --- Strategic Model Routing ---
FAST_MODEL_NAME=gemini-2.5-flash
PLANNING_MODEL_NAME=gemini-2.5-pro

# --- Storage & Persistent Memory ---
# Options: sqlite (local persistent DB) | vertex (Vertex AI Session & Memory Bank)
AGENT_STORAGE_BACKEND=sqlite
SESSION_DB_PATH=./data/travel_sessions.db
MEMORY_DB_PATH=./data/travel_memory.db

# --- History Compaction ---
COMPACTION_INTERVAL=6
COMPACTION_OVERLAP_SIZE=2
COMPACTION_TOKEN_THRESHOLD=4000
COMPACTION_EVENT_RETENTION_SIZE=4

# --- Security, Privacy & Guardrails ---
ENABLE_CLOUD_DLP=false
MAX_SINGLE_TRIP_BUDGET_USD=25000.0
APPROVAL_TTL_SECONDS=900

# --- Observability ---
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=smart-travel-concierge-agent
OTEL_EXPORT_CLOUD_TRACE=false
